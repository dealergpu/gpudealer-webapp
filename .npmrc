auto-install-peers=false
strict-peer-dependencies=false

# ============================================================================
# SECURITY: Minimum release age for npm packages (supply-chain attack defense)
# ============================================================================
# Requires that any npm package version must have been published for at
# least 1 day (1440 minutes) before pnpm will allow installing it. Malicious
# npm releases are usually discovered and pulled within hours, so this delay
# provides a strong safety buffer. DO NOT remove or set to 0.
minimum-release-age=1440
